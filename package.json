{
  "name": "co-cane-cabana-spending-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --local",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply spending-tracker-db --local --force",
    "db:migrate:staging": "wrangler d1 migrations apply spending-tracker-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply spending-tracker-db --remote --env production",
    "db:validate": "wrangler d1 migrations apply spending-tracker-db --local --persist-to=.wrangler/migration-validation --force",
    "typecheck": "tsc -b",
    "test:db": "node --test tests/db.test.mjs",
    "test:migrations": "node --test tests/migrations.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:analytics": "node --test tests/analytics.test.mjs",
    "db:backup": "wrangler d1 export spending-tracker-db --local --output=backups/spending-tracker-local.sql",
    "db:backup:staging": "wrangler d1 export spending-tracker-staging --remote --env staging --output=backups/spending-tracker-staging.sql",
    "db:backup:production": "wrangler d1 export spending-tracker-db --remote --env production --output=backups/spending-tracker-production.sql",
    "db:backup:remote": "npm run db:backup:production",
    "db:restore": "wrangler d1 execute spending-tracker-db --local --file=backups/spending-tracker-local.sql",
    "db:restore:staging": "wrangler d1 execute DB --remote --env staging --file=backups/spending-tracker-staging.sql",
    "db:restore:production": "wrangler d1 execute DB --remote --env production --file=backups/spending-tracker-production.sql",
    "db:restore:remote": "npm run db:restore:production",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "deploy": "npm run deploy:production",
    "test:insights": "node --experimental-strip-types --test tests/insights.test.mjs",
    "test:observability": "node --experimental-strip-types --test tests/observability.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.168.0"
  }
}
